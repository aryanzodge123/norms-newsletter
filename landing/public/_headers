# Cloudflare Pages reads this file from the root of the deployed site. It is
# copied verbatim out of public/ by the build, so it is not hashed and not
# bundled.

# Vite content-hashes every filename under /assets, so the bytes behind one of
# these URLs never change: a new build produces a new name rather than new
# contents at the old name. Pages defaults them to four hours with
# revalidation, which spends a conditional request on every visit to be told
# nothing changed. Immutable is what the hashing already guarantees.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The one file that must never be held. It is the only thing that knows the
# current asset names, so a stale copy asks for files that no longer exist and
# the page renders without its stylesheet. Pages already sends max-age=0 here.
# Stating it means a future change to the defaults cannot quietly take it away.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Same reasoning for the second document. A held copy of this one asks for
# asset names that no longer exist, and the page renders without its stylesheet.
/faq
  Cache-Control: public, max-age=0, must-revalidate
/faq.html
  Cache-Control: public, max-age=0, must-revalidate

# And the third. Same reasoning again: a held copy names asset hashes that no
# longer exist after the next build, and the page renders unstyled.
/blog
  Cache-Control: public, max-age=0, must-revalidate
/blog.html
  Cache-Control: public, max-age=0, must-revalidate

# The six hero stills. They sit in public/ rather than under /assets, so the
# hashing that earns the immutable rule above does not apply to them and Pages
# defaults them to four hours with revalidation. They are regenerated by hand
# from prototypes/ and change perhaps twice a year, so a day is the right
# trade: not immutable, because the name would not change if the image did.
/app-today.webp
  Cache-Control: public, max-age=86400
/app-listen.webp
  Cache-Control: public, max-age=86400
/app-story.webp
  Cache-Control: public, max-age=86400
/app-archive.webp
  Cache-Control: public, max-age=86400
/app-topics.webp
  Cache-Control: public, max-age=86400
/app-norm.webp
  Cache-Control: public, max-age=86400

# The Claude Design export, dropped in whole and served at /prototype. It is a
# working reference for one person on a phone, not part of the public page, so
# it is kept out of every index. robots.txt says Allow: / and the bundle
# replaces the whole document once it unpacks, which would wipe a meta robots
# tag in the head, so the header is the only instruction that survives.
/prototype
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate
/prototype.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate
